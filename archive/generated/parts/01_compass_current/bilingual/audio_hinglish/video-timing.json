    {
      "id": "particles",
      "start": 18,
      "end": 21,
      "text": "\u091b\u094b\u091f\u0947 \u0928\u0940\u0932\u0947 \u092c\u093f\u0902\u0926\u0941 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928 \u0939\u0948\u0902\u0964 \u0924\u093e\u0901\u092c\u0947 \u0915\u0947 \u0930\u0902\u0917 \u0935\u093e\u0932\u0947 \u0917\u094b\u0932\u0947, \u0924\u093e\u0901\u092c\u0947 \u0915\u0947 \u0906\u092f\u0928 \u0939\u0948\u0902\u0964 \u0906\u092f\u0928 \u0905\u092a\u0928\u0940 \u091c\u0917\u0939 \u0915\u0947 \u0906\u0938\u092a\u093e\u0938 \u0915\u0902\u092a\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0926\u094b\u0928\u094b\u0902 \u0915\u094b \u092a\u0939\u091a\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0930\u0902\u0917 \u0926\u093f\u0916\u093e\u090f \u0939\u0948\u0902\u0964",
      "speech_text": "\u091b\u094b\u091f\u0947 \u0928\u0940\u0932\u0947 \u092c\u093f\u0902\u0926\u0941 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928 \u0939\u0948\u0902\u0964 \u0924\u093e\u0902\u092c\u0947 \u0915\u0947 \u0930\u0902\u0917 \u0935\u093e\u0932\u0947 \u0917\u094b\u0932\u0947, \u0924\u093e\u0902\u092c\u0947 \u0915\u0947 \u0906\u092f\u0928 \u0939\u0948\u0902\u0964 \u0906\u092f\u0928 \u0905\u092a\u0928\u0940 \u091c\u0917\u0939 \u0915\u0947 \u0906\u0938\u092a\u093e\u0938 \u0915\u0902\u092a\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0926\u094b\u0928\u094b\u0902 \u0915\u094b \u092a\u0939\u091a\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0930\u0902\u0917 \u0926\u093f\u0916\u093e\u090f \u0939\u0948\u0902\u0964",
